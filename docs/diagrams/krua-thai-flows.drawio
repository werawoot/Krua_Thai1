<mxfile host="Electron" agent="Krua Thai docs generator" version="24.0.0"><diagram name="1. System Context" id="1._System_Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Krua Thai: System Context (C4 ระดับ 1)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#333333;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="36" as="geometry"/></mxCell><mxCell id="c2" value="ระบบคุยกับใคร และพึ่งระบบภายนอกอะไรบ้าง (to-be ตามโมเดลธุรกิจที่ตกลงแล้ว)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#555555;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;สมัคร Subscription, เลือกเมนูรายสัปดาห์, Skip / Pause / Cancel" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="240" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;จัดการ Plan, Weekly Menu, Subscription และมอบงานให้ Rider" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="240" height="130" as="geometry